# Copy to `.env`. See the container section of docs/deploy.md.

# Files roost writes into your checkouts must be owned by you, so the image is
# built for your uid rather than a fixed one.
UID=1000
GID=1000

# The directory holding your checkouts. Mounted at this SAME PATH inside the
# container — not /projects. Git worktrees, roost's .origin markers and Claude
# Code's transcript directories all record absolute paths, and every one of them
# breaks silently if the mount is remapped.
ROOST_PROJECTS=/home/you/projects
